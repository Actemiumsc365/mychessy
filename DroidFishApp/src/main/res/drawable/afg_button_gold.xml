<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#FF5A4636" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#FFB8860B" />
            <stroke android:width="2dp" android:color="#FFFFE7A3" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:angle="90"
                android:startColor="#FFB8860B"
                android:endColor="#FFE6C35C" />
            <stroke android:width="1dp" android:color="#FF7B4B26" />
        </shape>
    </item>
</selector>
